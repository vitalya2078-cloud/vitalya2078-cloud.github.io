<?xml version="1.0" encoding="utf-8"?>
<!-- Прогресс (localStorage WebView) переносится при смене телефона через резервную копию Google -->
<data-extraction-rules>
    <cloud-backup><include domain="root" path="app_webview/" /></cloud-backup>
    <device-transfer><include domain="root" path="app_webview/" /></device-transfer>
</data-extraction-rules>
