// Ресурсы Fizpraktikum.exe: значок, интерфейс (app.pak), манифест, сведения о программе.
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#ifndef FZ_VER_COMMA
#define FZ_VER_COMMA 0,0,0,0
#define FZ_VER_STR "0.0.0"
#endif
IDI_APP ICON "../src-tauri/icons/icon.ico"
IDR_APP_PAK RCDATA "app.pak"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION FZ_VER_COMMA
PRODUCTVERSION FZ_VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "ЧВВМУ им. П.С. Нахимова"
      VALUE "FileDescription", "Физпрактикум"
      VALUE "ProductName", "Физпрактикум"
      VALUE "FileVersion", FZ_VER_STR
      VALUE "ProductVersion", FZ_VER_STR
      VALUE "OriginalFilename", "Fizpraktikum.exe"
      VALUE "LegalCopyright", "© 2026 ЧВВМУ им. П.С. Нахимова"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
