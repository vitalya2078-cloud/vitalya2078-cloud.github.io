{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Физпрактикум",
  "mainBinaryName": "Fizpraktikum",
  "version": "2.7.0",
  "identifier": "io.github.vitalya2078.lw3",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Физпрактикум",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "backgroundColor": "#080D1A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ЧВВМУ им. П.С. Нахимова, кафедра физики и общетехнических дисциплин",
    "shortDescription": "Физпрактикум - виртуальный лабораторный практикум по физике",
    "longDescription": "Лабораторные работы по физике в виртуальной лаборатории, конспекты, видеоуроки, тесты и экзамены. Разработано для ЧВВМУ им. П.С. Нахимова, кафедра физики и общетехнических дисциплин.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./WebView2Runtime/"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "© 2026 ЧВВМУ им. П.С. Нахимова, кафедра физики и общетехнических дисциплин",
    "licenseFile": "license.txt"
  }
}
