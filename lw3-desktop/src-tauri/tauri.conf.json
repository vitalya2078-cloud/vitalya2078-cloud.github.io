{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Физпрактикум",
  "mainBinaryName": "lw3-adiabata",
  "version": "2.2.0",
  "identifier": "io.github.vitalya2078.lw3",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Физпрактикум",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "backgroundColor": "#080D1A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Кафедра физики",
    "shortDescription": "Определение показателя адиабаты воздуха",
    "longDescription": "Определение показателя адиабаты воздуха методом Клемана — Дезорма: допуск, опыты на установке, обработка, защита и отчёт.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
